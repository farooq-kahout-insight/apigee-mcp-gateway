<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-Unknown-Resource">
    <DisplayName>RF-Unknown-Resource</DisplayName>
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">{"error":"not_found","message":"No such operation on this gateway."}</Payload>
            <StatusCode>404</StatusCode>
            <ReasonPhrase>Not Found</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
