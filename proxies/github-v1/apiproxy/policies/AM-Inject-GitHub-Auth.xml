<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Inject-GitHub-Auth">
    <DisplayName>AM-Inject-GitHub-Auth</DisplayName>
    <!-- Runs only after FC-Target-Hygiene has removed anything the client sent,
         so the PAT can never be shadowed by a caller-supplied Authorization.
         IgnoreUnresolvedVariables is false on purpose: if the KVM lookup came
         back empty this policy fails and the request becomes a sanitized 500,
         rather than sending the literal string "Bearer {private.github_pat}"
         to GitHub and logging a failed auth attempt upstream. -->
    <Set>
        <Headers>
            <Header name="Authorization">Bearer {private.github_pat}</Header>
            <Header name="Accept">application/vnd.github+json</Header>
            <Header name="X-GitHub-Api-Version">2022-11-28</Header>
            <Header name="User-Agent">agent-airlock-gateway</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
