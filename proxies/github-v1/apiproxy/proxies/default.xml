<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <!-- Fault handling is identical to weather-v1 by construction: both call the
         same shared flow rather than keeping their own copy of the rules. -->
    <FaultRules>
        <FaultRule name="sanitize">
            <Step>
                <Name>FC-Fault-Sanitizer</Name>
            </Step>
            <!-- The fault path is the one the audit most needs to cover, and it
                 is the one PostFlow never reaches: a refusal short-circuits
                 straight to here. Building the record at the end of the rule
                 means a denied write is audited exactly like a served one. -->
            <Step>
                <Name>FC-Audit-Build</Name>
            </Step>
        </FaultRule>
    </FaultRules>
    <DefaultFaultRule name="default-fault">
        <Step>
            <Name>FC-Fault-Sanitizer</Name>
        </Step>
        <!-- The fault path is the one the audit most needs to cover, and it
             is the one PostFlow never reaches: a refusal short-circuits
             straight to here. Building the record at the end of the rule
             means a denied write is audited exactly like a served one. -->
        <Step>
            <Name>FC-Audit-Build</Name>
        </Step>
    </DefaultFaultRule>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>FC-Inbound-Security</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <!-- Both issue flows re-check the repository. The API Product already
             scopes *which verbs* an identity may use; the allowlist scopes
             *which repository* the stored PAT may be spent on. They are
             independent controls and neither substitutes for the other. -->
        <Flow name="ListIssues">
            <Description>List issues on the allowlisted repository</Description>
            <Condition>(proxy.pathsuffix MatchesPath "/repos/*/*/issues") and (request.verb = "GET")</Condition>
            <Request>
                <Step>
                    <Name>EV-Repo-Path</Name>
                </Step>
                <Step>
                    <Name>AM-Build-Repo-Key</Name>
                </Step>
                <Step>
                    <Name>KVM-Get-Allowed-Repo</Name>
                </Step>
                <Step>
                    <Name>RF-Repo-Denied</Name>
                    <Condition>(gh.repo_full != gh.allowed_repo)</Condition>
                </Step>
            </Request>
            <Response/>
        </Flow>
        <Flow name="CreateIssue">
            <Description>Create an issue -- operator scope only, via the API Product</Description>
            <Condition>(proxy.pathsuffix MatchesPath "/repos/*/*/issues") and (request.verb = "POST")</Condition>
            <Request>
                <Step>
                    <Name>EV-Repo-Path</Name>
                </Step>
                <Step>
                    <Name>AM-Build-Repo-Key</Name>
                </Step>
                <Step>
                    <Name>KVM-Get-Allowed-Repo</Name>
                </Step>
                <Step>
                    <Name>RF-Repo-Denied</Name>
                    <Condition>(gh.repo_full != gh.allowed_repo)</Condition>
                </Step>
                <!-- Rebuild the payload from an allowlist of fields before it is
                     ever sent upstream. -->
                <Step>
                    <Name>JS-Build-Issue</Name>
                </Step>
                <Step>
                    <Name>RF-Missing-Title</Name>
                    <Condition>(airlock.issue.error != null)</Condition>
                </Step>
            </Request>
            <Response/>
        </Flow>
        <!-- Explicit allowlist: no unmatched path is ever proxied to GitHub. -->
        <Flow name="UnknownResource">
            <Description>Anything not matched above is rejected, not forwarded</Description>
            <Request>
                <Step>
                    <Name>RF-Unknown-Resource</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step>
                <Name>FC-Outbound-Redaction</Name>
            </Step>
            <!-- Assembling the record here, not in PostClientFlow: that flow runs
                 MessageLogging policies and nothing else, so a JavaScript step
                 placed there reports success and quietly does nothing. Running
                 after redaction also means the record can never describe a
                 response body that the caller was not allowed to see. -->
            <Step>
                <Name>FC-Audit-Build</Name>
            </Step>
        </Response>
    </PostFlow>
    <PostClientFlow name="PostClientFlow">
        <Response>
            <!-- Only the write lives here. PostClientFlow is the one hook that
                 runs unconditionally: after the response has reached the
                 client, equally for a refusal, a fault or a success. So the
                 audit costs the caller nothing and cannot be skipped by an
                 early exit. An audit that only records the requests that
                 worked is not an audit. -->
            <Step>
                <Name>FC-Audit-Log</Name>
            </Step>
        </Response>
    </PostClientFlow>
    <HTTPProxyConnection>
        <BasePath>/github/v1</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
