<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Bearer-To-ApiKey">
    <DisplayName>AM-Bearer-To-ApiKey</DisplayName>
    <!-- Copies the bearer token EV-Bearer-Key found into the header the shared
         flow actually verifies. Stepped only when x-api-key is absent, so a
         caller that sends both spellings is verified against x-api-key and this
         policy never silently overrides it.

         Neither header reaches the target: sf-target-hygiene strips
         Authorization and x-api-key before AM-Inject-OpenRouter-Auth writes the
         real credential, so the consumer key cannot leak upstream. -->
    <Set>
        <Headers>
            <Header name="x-api-key">{llm.bearer_key}</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
