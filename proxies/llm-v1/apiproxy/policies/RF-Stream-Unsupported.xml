<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-Stream-Unsupported">
    <DisplayName>RF-Stream-Unsupported</DisplayName>
    <!-- This one message does name the reason, because unlike a denied model it
         is not a security boundary: the client needs to know to retry without
         the flag, and "stream" was in its own request. See llm_guard.js for why
         streaming is refused rather than passed through. -->
    <FaultResponse>
        <Set>
            <Payload contentType="application/json">{"error":"bad_request","message":"Streaming responses are not supported by this gateway."}</Payload>
            <StatusCode>400</StatusCode>
            <ReasonPhrase>Bad Request</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
