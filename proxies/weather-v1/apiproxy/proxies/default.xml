<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <!-- Every error leaves through here with a fixed {"error","message"} shape.
         Apigee's own fault text names policies and internals, so it is never
         forwarded to the caller. -->
    <FaultRules>
        <!-- Apigee evaluates FaultRules BOTTOM-UP and runs the first match, so
             the broad catch-all sits at the top and the most specific rule at
             the bottom. Reordering these silently changes the status codes. -->
        <FaultRule name="unauthorized">
            <Step>
                <Name>AM-Fault-Unauthorized</Name>
            </Step>
            <!-- VerifyAPIKey publishes its state under the oauthV2. prefix,
                 not the policy name. -->
            <Condition>(oauthV2.VA-VerifyAPIKey.failed = "true")</Condition>
        </FaultRule>
        <FaultRule name="rate-limited">
            <Step>
                <Name>AM-Fault-RateLimited</Name>
            </Step>
            <Condition>(fault.name = "SpikeArrestViolation")</Condition>
        </FaultRule>
        <FaultRule name="quota-exceeded">
            <Step>
                <Name>AM-Fault-QuotaExceeded</Name>
            </Step>
            <Condition>(fault.name = "QuotaViolation")</Condition>
        </FaultRule>
        <FaultRule name="scope-denied">
            <!-- Key is valid but the operation is not in its API Product.
                 Apigee calls that 401; semantically it is a 403. -->
            <Step>
                <Name>AM-Forbidden-Scope</Name>
            </Step>
            <Condition>(fault.name = "InvalidApiKeyForGivenResource")</Condition>
        </FaultRule>
    </FaultRules>
    <DefaultFaultRule name="default-fault">
        <!-- RaiseFault policies already emit a sanitized body; everything else
             collapses to a generic 500 so no internals escape. -->
        <Step>
            <Name>AM-Fault-Internal</Name>
            <Condition>(fault.name != "RaiseFault")</Condition>
        </Step>
    </DefaultFaultRule>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>VA-VerifyAPIKey</Name>
            </Step>
            <!-- Identified throttling: both policies key on client_id, so they
                 must run after the key is verified. -->
            <Step>
                <Name>SA-SpikeArrest</Name>
            </Step>
            <Step>
                <Name>Q-Quota</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="GetForecast">
            <Description>Open-Meteo forecast</Description>
            <Condition>(proxy.pathsuffix MatchesPath "/forecast") and (request.verb = "GET")</Condition>
            <Request/>
            <Response/>
        </Flow>
        <Flow name="GetArchive">
            <Description>Open-Meteo historical archive (operator scope only)</Description>
            <Condition>(proxy.pathsuffix MatchesPath "/archive") and (request.verb = "GET")</Condition>
            <Request/>
            <Response/>
        </Flow>
        <Flow name="UnknownResource">
            <Description>Explicit allowlist: anything not matched above is rejected</Description>
            <Request>
                <Step>
                    <Name>RF-Unknown-Resource</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow"/>
    <HTTPProxyConnection>
        <BasePath>/weather/v1</BasePath>
    </HTTPProxyConnection>
    <!-- Ordered: first matching rule wins, unconditional 'default' is last. -->
    <RouteRule name="archive">
        <TargetEndpoint>archive</TargetEndpoint>
        <Condition>(proxy.pathsuffix MatchesPath "/archive")</Condition>
    </RouteRule>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
