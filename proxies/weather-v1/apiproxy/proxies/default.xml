<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <!-- Every error leaves through here with a fixed {"error","message"} shape.
         Apigee's own fault text names policies and internals, so it is never
         forwarded to the caller. The classification lives in sf-fault-sanitizer
         so both proxies cannot drift apart; a single unconditional rule here
         also sidesteps Apigee's bottom-up first-match fault ordering, which
         made status codes depend on the order rules happened to be written in. -->
    <FaultRules>
        <FaultRule name="sanitize">
            <Step>
                <Name>FC-Fault-Sanitizer</Name>
            </Step>
        </FaultRule>
    </FaultRules>
    <DefaultFaultRule name="default-fault">
        <Step>
            <Name>FC-Fault-Sanitizer</Name>
        </Step>
    </DefaultFaultRule>
    <PreFlow name="PreFlow">
        <Request>
            <!-- Identity, throttling and payload screening now live in a shared
                 flow so every proxy gets the identical chain in the identical
                 order. The policies moved out of this bundle; the fault rules
                 above still key on their names, which the callout preserves. -->
            <Step>
                <Name>FC-Inbound-Security</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="GetForecast">
            <Description>Open-Meteo forecast</Description>
            <Condition>(proxy.pathsuffix MatchesPath "/forecast") and (request.verb = "GET")</Condition>
            <Request/>
            <Response/>
        </Flow>
        <Flow name="GetArchive">
            <Description>Open-Meteo historical archive (operator scope only)</Description>
            <Condition>(proxy.pathsuffix MatchesPath "/archive") and (request.verb = "GET")</Condition>
            <Request/>
            <Response/>
        </Flow>
        <Flow name="SelfTestRedact">
            <Description>Serves a canned credential-shaped payload so the
                redaction and threat-protection policies can be proven end to
                end without a backend. Operator scope only.</Description>
            <Condition>(proxy.pathsuffix MatchesPath "/selftest")</Condition>
            <Request>
                <Step>
                    <Name>AM-SelfTest-Payload</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
        <Flow name="UnknownResource">
            <Description>Explicit allowlist: anything not matched above is rejected</Description>
            <Request>
                <Step>
                    <Name>RF-Unknown-Resource</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <!-- Applies to every response, upstream or locally generated. -->
            <Step>
                <Name>FC-Outbound-Redaction</Name>
            </Step>
        </Response>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/weather/v1</BasePath>
    </HTTPProxyConnection>
    <!-- Ordered: first matching rule wins, unconditional 'default' is last. -->
    <RouteRule name="selftest-no-target">
        <Condition>(proxy.pathsuffix MatchesPath "/selftest")</Condition>
    </RouteRule>
    <RouteRule name="archive">
        <TargetEndpoint>archive</TargetEndpoint>
        <Condition>(proxy.pathsuffix MatchesPath "/archive")</Condition>
    </RouteRule>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
