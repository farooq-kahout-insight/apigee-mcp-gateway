<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Fault-NotFound">
    <DisplayName>AM-Fault-NotFound</DisplayName>
    <Set>
        <Payload contentType="application/json">{"error":"not_found","message":"No such operation on this gateway."}</Payload>
        <StatusCode>404</StatusCode>
        <ReasonPhrase>Not Found</ReasonPhrase>
    </Set>
    <!-- Drop anything Apigee may have attached to the error response. -->
    <Remove>
        <Headers>
            <Header>X-Apigee-fault-code</Header>
            <Header>X-Apigee-fault-source</Header>
            <Header>X-Apigee-fault-policy</Header>
        </Headers>
    </Remove>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
