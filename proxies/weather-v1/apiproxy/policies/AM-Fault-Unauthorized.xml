<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Fault-Unauthorized">
    <DisplayName>AM-Fault-Unauthorized</DisplayName>
    <Set>
        <Payload contentType="application/json">{"error":"unauthorized","message":"Missing or invalid API key."}</Payload>
        <StatusCode>401</StatusCode>
        <ReasonPhrase>Unauthorized</ReasonPhrase>
    </Set>
    <!-- Drop anything Apigee may have attached to the error response. -->
    <Remove>
        <Headers>
            <Header>X-Apigee-fault-code</Header>
            <Header>X-Apigee-fault-source</Header>
            <Header>X-Apigee-fault-policy</Header>
        </Headers>
    </Remove>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
