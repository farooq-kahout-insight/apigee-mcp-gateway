<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Strip-Client-Credentials">
    <DisplayName>AM-Strip-Client-Credentials</DisplayName>
    <!-- The client's gateway credential is for Apigee only and must never reach a
         backend. Also drops any client-supplied Authorization so it can never be
         mistaken for (or shadow) the credential Apigee injects from the KVM. -->
    <Remove>
        <Headers>
            <Header>x-api-key</Header>
            <Header>apikey</Header>
            <Header>Authorization</Header>
            <Header>Proxy-Authorization</Header>
        </Headers>
    </Remove>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
