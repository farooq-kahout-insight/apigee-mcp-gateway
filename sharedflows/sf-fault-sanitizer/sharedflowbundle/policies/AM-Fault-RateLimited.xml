<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Fault-RateLimited">
    <DisplayName>AM-Fault-RateLimited</DisplayName>
    <Set>
        <Payload contentType="application/json">{"error":"rate_limited","message":"Too many requests too quickly. Slow down and retry."}</Payload>
        <StatusCode>429</StatusCode>
        <ReasonPhrase>Too Many Requests</ReasonPhrase>
    </Set>
    <!-- Drop anything Apigee may have attached to the error response. -->
    <Remove>
        <Headers>
            <Header>X-Apigee-fault-code</Header>
            <Header>X-Apigee-fault-source</Header>
            <Header>X-Apigee-fault-policy</Header>
        </Headers>
    </Remove>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
