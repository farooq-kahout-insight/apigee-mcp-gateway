<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Fault-BadRequest">
    <DisplayName>AM-Fault-BadRequest</DisplayName>
    <Set>
        <Payload contentType="application/json">{"error":"bad_request","message":"Request payload or parameters were rejected by policy."}</Payload>
        <StatusCode>400</StatusCode>
        <ReasonPhrase>Bad Request</ReasonPhrase>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
