<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RegularExpressionProtection continueOnError="false" enabled="true" name="REP-Injection">
    <DisplayName>REP-Injection</DisplayName>
    <!-- Patterns match the RAW query string and body, so every whitespace,
         equals and quote class also accepts its percent-encoded form.
         Note the deliberate absence of \b in the query-string patterns: in
         ?q='%20OR%201=1 the character before OR is the '0' of %20, so a word
         boundary never occurs there. A non-letter guard is used instead.
         Apigee anchors these patterns, hence the leading and trailing .* -->
    <Source>request</Source>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <Variable name="request.querystring">
        <Pattern>(?is).*(^|[^a-z])(or|and)(\s|%20|\+)+[0-9'"%]+(\s|%20|\+)*(=|%3[dD])(\s|%20|\+)*[0-9'"%]+.*</Pattern>
        <Pattern>(?is).*(^|[^a-z])union(\s|%20|\+)+select([^a-z]|$).*</Pattern>
        <Pattern>(?is).*(;|%3[bB])(\s|%20|\+)*drop(\s|%20|\+)+table([^a-z]|$).*</Pattern>
        <Pattern>(?is).*(&lt;|%3[cC])(\s|%20|\+)*(script|iframe|img|svg).*</Pattern>
        <Pattern>(?is).*javascript(:|%3[aA]).*</Pattern>
        <Pattern>(?is).*(^|[^a-z])on(error|load|click|mouseover)(\s|%20|\+)*(=|%3[dD]).*</Pattern>
    </Variable>
    <Variable name="request.content">
        <Pattern>(?is).*(^|[^a-z])(or|and)\s+[0-9'"]+\s*=\s*[0-9'"]+.*</Pattern>
        <Pattern>(?is).*(^|[^a-z])union\s+select([^a-z]|$).*</Pattern>
        <Pattern>(?is).*;\s*drop\s+table([^a-z]|$).*</Pattern>
        <Pattern>(?is).*&lt;\s*(script|iframe|img|svg).*</Pattern>
        <Pattern>(?is).*javascript:.*</Pattern>
    </Variable>
</RegularExpressionProtection>
