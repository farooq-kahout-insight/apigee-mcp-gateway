<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<SharedFlow name="default">
    <!-- Order matters and is the whole point of centralising this: the
         caller's address is snapshotted first because it is the one fact that
         is destroyed later in the request, and because it must be recorded
         even for a request that never gets an identity. Then identity, then throttling
         (SpikeArrest and Quota key on client_id, so they are meaningless
         before VerifyAPIKey has run), then the payload screens. Faults raised here surface in the calling proxy's
         FaultRules, which is where they are turned into sanitized bodies. -->
    <Step>
        <Name>AM-Capture-Caller</Name>
    </Step>
    <Step>
        <Name>VA-VerifyAPIKey</Name>
    </Step>
    <Step>
        <Name>SA-SpikeArrest</Name>
    </Step>
    <Step>
        <Name>Q-Quota</Name>
    </Step>
    <!-- The injection screen is two policies rather than one so that the body
         half can be waived by a proxy whose body is natural language. A query
         string is never natural language here, so the query half is
         unconditional on every proxy. -->
    <Step>
        <Name>REP-Injection-Query</Name>
    </Step>
    <Step>
        <Name>REP-Injection-Body</Name>
        <Condition>(inbound.skip_body_screen != "true")</Condition>
    </Step>
    <!-- Bodies only: GETs carry none, so skip the parse entirely. A proxy that
         needs structural limits other than the shared defaults sets
         inbound.jtp to "custom" and steps its own JSONThreatProtection. -->
    <Step>
        <Name>JTP-JSONThreatProtection</Name>
        <Condition>(request.verb != "GET") and (request.verb != "HEAD") and (inbound.jtp != "custom")</Condition>
    </Step>
</SharedFlow>
