# ---- Apigee control plane ----
APIGEE_ORG=your-gcp-project-id
APIGEE_ENV=eval
APIGEE_ENVGROUP=eval-group
APIGEE_HOST=YOUR_LB_IP.nip.io

# ---- Agent identities (consumer keys, filled by scripts/provision.sh) ----
# These are API keys, not secrets-of-record. Safe in a local .env, never committed.
AGENT_READER_KEY=
AGENT_OPERATOR_KEY=

# ---- Backend secrets (NEVER committed, NEVER read by the MCP server) ----
# Only scripts/provision.sh reads this, to push it into the Apigee encrypted KVM.
# Export it in your shell right before running provision.sh, then unset it.
GITHUB_PAT=
# Repo the github-v1 proxy is allowed to touch, e.g. myuser/airlock-test
GITHUB_TEST_REPO=
