# ---- Apigee control plane ----
APIGEE_ORG=your-gcp-project-id
APIGEE_ENV=eval
APIGEE_ENVGROUP=eval-group
APIGEE_HOST=YOUR_LB_IP.nip.io

# ---- Agent identities (consumer keys, filled by scripts/provision.sh) ----
# These are API keys, not secrets-of-record. Safe in a local .env, never committed.
AGENT_READER_KEY=
AGENT_OPERATOR_KEY=

# ---- Backend secrets (NEVER committed, NEVER read by the MCP server) ----
# Only scripts/provision.sh reads this, to push it into the Apigee encrypted KVM.
# Export it in your shell right before running provision.sh, then unset it.
GITHUB_PAT=
# The single repo github-v1 is allowed to touch, e.g. myuser/airlock-test.
# Read by provision.sh into the gateway-config KVM; the proxy refuses any other.
GITHUB_ALLOWED_REPO=

# Same handling as GITHUB_PAT: provision.sh pushes it into the encrypted KVM and
# nothing else ever reads it. Agents authenticate to llm-v1 with their own Apigee
# key; this key is the gateway's, and it never leaves the KVM.
OPENROUTER_API_KEY=
# Comma-separated model IDs llm-v1 will accept, e.g.
# meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-7b-instruct:free
# JS-LLM-Guard fails closed on this: unset means every model is denied.
LLM_ALLOWED_MODELS=
# Ceiling llm-v1 clamps max_tokens to. Unlike the allowlist this fails open --
# absent, the guard falls back to its own built-in default.
LLM_MAX_TOKENS=

# Same handling as GITHUB_PAT: provision.sh pushes it into the encrypted KVM and
# nothing else ever reads it. The MCP server and both agents refuse to start if
# they find SLACK_BOT_TOKEN in their own environment.
SLACK_BOT_TOKEN=
# Comma-separated Slack channel IDs slack-v1 will act on, e.g. C09ABCDEF,C09XYZ12.
# IDs, not #names: a channel can be renamed, and an allowlist a rename can
# silently redirect is not one. provision.sh writes one KVM entry per channel and
# the proxy fails closed on a miss, so unset means every channel is denied.
SLACK_ALLOWED_CHANNELS=

# ---- Where the alarms ring ----
# Display names of the Cloud Monitoring notification channels the quota and
# security alerts fan out to, comma-separated. Looked up by name, never created:
# add the Slack one through the Monitoring console (Alerting -> Edit notification
# channels -> Slack) so Google can run its own OAuth against the workspace, then
# name it exactly as it appears here. This is the channel's *Monitoring display
# name*, matched literally -- not the Slack channel name, even where the two
# happen to coincide. Point it at a channel slack-v1 is NOT allowlisted for: an
# alarm delivered through the thing it is watching is not an alarm.
ALERT_CHANNEL_TITLES=ai-gateway-alerts
